<%- include('../partials/head', { title: product.name }) %>
<%- include('../partials/navbar') %>
<main class="container py-4 page-shell">
    <%- include('../partials/messages') %>
    <%- include('../partials/back-button', { backUrl: '/' }) %>
    <div class="card product-detail-card border-0">
        <div class="row g-0">
            <div class="col-lg-6 detail-image-panel">
                <% if (product.image) { %>
                    <img class="detail-image" src="/uploads/<%= product.image %>" alt="<%= product.name %>">
                <% } else { %>
                    <div class="product-placeholder detail-placeholder">♻</div>
                <% } %>
            </div>
            <div class="col-lg-6">
                <div class="detail-content">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge product-category"><%= product.category %></span>
                        <span class="badge product-condition"><%= product.item_condition.replace('_', ' ') %></span>
                        <span class="badge rounded-pill text-bg-success status-badge"><%= product.status %></span>
                    </div>
                    <h1 class="display-6 fw-bold mb-3"><%= product.name %></h1>
                    <p class="product-description"><%= product.description %></p>
                    <p class="detail-price">$<%= Number(product.price).toFixed(2) %></p>

                    <div class="product-facts mb-4">
                        <div>
                            <span class="fact-label">Available</span>
                            <strong><%= product.quantity %> item<%= Number(product.quantity) === 1 ? '' : 's' %></strong>
                        </div>
                        <div>
                            <span class="fact-label">Seller</span>
                            <strong><a href="/users/<%= product.seller_id %>"><%= product.seller_name %></a></strong>
                        </div>
                        <div>
                            <span class="fact-label">Seller rating</span>
                            <strong><span class="rating-star">★</span> <%= Number(product.average_rating).toFixed(1) %></strong>
                            <span class="text-secondary small"><%= product.review_count %> review<%= Number(product.review_count) === 1 ? '' : 's' %></span>
                        </div>
                    </div>

                    <% if (currentUser && currentUser.id !== product.seller_id && product.status === 'approved') { %>
                        <section class="purchase-panel" aria-labelledby="reservationActions">
                            <h2 class="h5 mb-1" id="reservationActions">Interested in this item?</h2>
                            <p class="text-secondary small mb-3">Save it for later, add it to your cart, or request a reservation now.</p>
                            <form class="mb-2" method="POST" action="/wishlist/add/<%= product.id %>">
                                <button class="btn btn-outline-danger w-100" type="submit">♡ Add to wishlist</button>
                            </form>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <form method="POST" action="/cart/add/<%= product.id %>">
                                        <label class="form-label small fw-semibold" for="cartQuantity">Cart quantity</label>
                                        <div class="input-group">
                                            <input class="form-control" id="cartQuantity" type="number" name="quantity" min="1" max="<%= product.quantity %>" value="1">
                                            <button class="btn btn-outline-success" type="submit">Add to cart</button>
                                        </div>
                                    </form>
                                </div>
                                <div class="col-sm-6">
                                    <form method="POST" action="/reservations/create/<%= product.id %>">
                                        <label class="form-label small fw-semibold" for="reserveQuantity">Reserve quantity</label>
                                        <div class="input-group">
                                            <input class="form-control" id="reserveQuantity" type="number" name="quantity" min="1" max="<%= product.quantity %>" value="1">
                                            <button class="btn btn-success" type="submit">Reserve</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </section>
                        <a class="report-link" href="/reports/product/<%= product.id %>">Report this product</a>
                    <% } else if (!currentUser) { %>
                        <div class="purchase-panel">
                            <h2 class="h5">Interested in this item?</h2>
                            <p class="text-secondary">Log in to add it to your wishlist, cart, or reservations.</p>
                            <a class="btn btn-success" href="/login">Log in to continue</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <section class="reviews-section">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h4 mb-0">Verified buyer reviews</h2>
            <span class="text-secondary small"><%= reviews.length %> review<%= reviews.length === 1 ? '' : 's' %></span>
        </div>
        <% if (reviews.length === 0) { %>
            <div class="empty-review-state">No reviews yet. Completed buyers can share their experience here.</div>
        <% } %>
        <% reviews.forEach(function(review) { %>
            <article class="card review-card mb-3"><div class="card-body">
            <strong><%= review.buyer_name %></strong>
            <span class="text-warning ms-2"><%= '★'.repeat(review.rating) %></span>
            <% if (currentUser && currentUser.role === 'admin') { %>
                <form class="d-inline ms-2" method="POST" action="/admin/ratings/<%= review.id %>/delete">
                    <button class="btn btn-sm btn-outline-danger" type="submit"
                            onclick="return confirm('Delete this rating? The buyer may be warned or banned for repeated removals.')">
                        Delete
                    </button>
                </form>
            <% } %>
            <p class="mb-0 mt-2"><%= review.comment || 'No written comment.' %></p>
            <% if (review.image) { %>
                <img class="rating-image img-fluid rounded border mt-3"
                     src="/uploads/<%= review.image %>" alt="Review image from <%= review.buyer_name %>">
            <% } %>
            </div></article>
        <% }); %>
    </section>
</main>
<%- include('../partials/footer') %>
