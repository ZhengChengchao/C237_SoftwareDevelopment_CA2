<%- include('partials/head', { title: 'Browse' }) %>
<%- include('partials/navbar') %>

<main class="container py-4 page-shell">
    <%- include('partials/messages') %>

    <section class="marketplace-intro mb-4">
        <div class="row align-items-end g-4">
            <div class="col-lg-5">
                <span class="eyebrow">Student marketplace</span>
                <h1 class="display-6 fw-bold mb-2">Find something useful</h1>
                <p class="text-secondary mb-0">Buy less, reuse more and discover affordable items from fellow RP students.</p>
            </div>
            <div class="col-lg-7">
                <form class="marketplace-filter" method="GET" action="/">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-5">
                            <label class="form-label" for="productSearch">Search</label>
                            <input class="form-control" id="productSearch" name="search" value="<%= search %>" placeholder="What are you looking for?">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="categoryFilter">Category</label>
                            <select class="form-select" id="categoryFilter" name="category">
                                <option value="">All categories</option>
                                <% categories.forEach(function(item) { %>
                                    <option value="<%= item.category %>" <%= category === item.category ? 'selected' : '' %>>
                                        <%= item.category %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label" for="sortFilter">Sort by</label>
                            <select class="form-select" id="sortFilter" name="sort">
                                <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
                                <option value="price_low" <%= sort === 'price_low' ? 'selected' : '' %>>Price: low to high</option>
                                <option value="price_high" <%= sort === 'price_high' ? 'selected' : '' %>>Price: high to low</option>
                                <option value="rating" <%= sort === 'rating' ? 'selected' : '' %>>Highest rated</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2 d-grid">
                            <button class="btn btn-success" type="submit">Search</button>
                        </div>
                    </div>
                    <% if (search || category || sort !== 'newest') { %>
                        <div class="mt-3 text-end">
                            <a class="filter-reset" href="/">Clear all filters</a>
                        </div>
                    <% } %>
                </form>
            </div>
        </div>
    </section>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 mb-0"><%= products.length %> product<%= products.length === 1 ? '' : 's' %> available</h2>
        <span class="text-secondary small">Approved campus listings</span>
    </div>

    <div class="row g-4">
        <% if (products.length === 0) { %>
            <div class="col-12"><div class="alert alert-info">No matching products found.</div></div>
        <% } %>
        <% products.forEach(function(product) { %>
            <div class="col-sm-6 col-lg-4">
                <article class="card product-card h-100">
                    <div class="product-image-frame">
                        <% if (product.image) { %>
                            <img class="product-image" src="/uploads/<%= product.image %>" alt="<%= product.name %>">
                        <% } else { %>
                            <div class="product-placeholder">♻</div>
                        <% } %>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <span class="badge product-category"><%= product.category %></span>
                            <span class="badge product-condition"><%= product.item_condition.replace('_', ' ') %></span>
                        </div>
                        <h3 class="product-card-title mt-3 mb-2"><%= product.name %></h3>
                        <p class="product-seller mb-2">Sold by <%= product.seller_name %></p>
                        <div class="product-rating mb-3" aria-label="Rating <%= Number(product.average_rating).toFixed(1) %> out of 5">
                            <span class="rating-star">★</span>
                            <strong><%= Number(product.average_rating).toFixed(1) %></strong>
                            <span class="text-secondary">(<%= product.review_count %> review<%= Number(product.review_count) === 1 ? '' : 's' %>)</span>
                        </div>
                        <p class="product-price mb-3">$<%= Number(product.price).toFixed(2) %></p>
                        <a class="btn btn-outline-success mt-auto" href="/products/<%= product.id %>">View product</a>
                    </div>
                </article>
            </div>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>
